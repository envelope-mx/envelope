APP_ENV=development

# Postgres connection (internal/db) — every Postgres-backed component
# (Directory, storage.Store, queue.Backend) shares this one connection.
# Set ENVELOPE_DB_DSN to override with a full DSN instead of the pieces
# below.
ENVELOPE_DB_HOST=127.0.0.1
ENVELOPE_DB_PORT=5432
ENVELOPE_DB_USER=envelope
ENVELOPE_DB_PASSWORD=envelope
ENVELOPE_DB_NAME=envelope
ENVELOPE_DB_SSLMODE=disable

# NFR-SEC-5 least-privilege roles (deploy/postgres/roles.sql) — optional,
# only takes effect for a process running exactly one --roles value (the
# Kubernetes per-Deployment shape; see internal/db.DSNForRole's doc for
# why a multi-role process can't use these). Unset by default, in which
# case every role keeps using the shared ENVELOPE_DB_USER/PASSWORD above.
# Set both halves of a pair together — a role name uppercased with "-"
# turned into "_" — for every role you've actually run roles.sql for:
# ENVELOPE_DB_USER_MIGRATOR=envelope_migrator
# ENVELOPE_DB_PASSWORD_MIGRATOR=
# ENVELOPE_DB_USER_API=envelope_api
# ENVELOPE_DB_PASSWORD_API=
# ENVELOPE_DB_USER_SMTP_INBOUND=envelope_smtp_inbound
# ENVELOPE_DB_PASSWORD_SMTP_INBOUND=
# ENVELOPE_DB_USER_SMTP_SUBMISSION=envelope_smtp_submission
# ENVELOPE_DB_PASSWORD_SMTP_SUBMISSION=
# ENVELOPE_DB_USER_IMAP=envelope_imap
# ENVELOPE_DB_PASSWORD_IMAP=
# ENVELOPE_DB_USER_DELIVERER=envelope_deliverer
# ENVELOPE_DB_PASSWORD_DELIVERER=

# NFR-SEC-5's fuller network segmentation (internal/internalapi) — an
# internal-only HTTP API, bundled into --roles=api, that
# smtp-inbound/smtp-submission/imap call instead of connecting to Postgres
# directly. Optional and per-role, like the ENVELOPE_DB_USER_<ROLE> block
# above: a role only activates it when running alone in its own process
# (Kubernetes's one-Deployment-per-role shape) AND its own token below is
# set — every default/bundled deployment is unaffected. Generate each
# token with: openssl rand -base64 32. The api role needs every token it
# should accept calls from; each SMTP-facing role needs only its own.
# ENVELOPE_INTERNAL_TOKEN_SMTP_INBOUND=
# ENVELOPE_INTERNAL_TOKEN_SMTP_SUBMISSION=
# ENVELOPE_INTERNAL_TOKEN_IMAP=
# ENVELOPE_INTERNAL_API_ADDR=:8081
# ENVELOPE_INTERNAL_API_URL=http://127.0.0.1:8081

# Required — TRD R1/NFR-SEC-3: encrypts DKIM private keys and webhook
# secrets at rest (internal/kms). The process refuses to boot without
# this. Generate one with: openssl rand -base64 32
# Losing this key makes every already-encrypted DKIM key and webhook
# secret permanently undecryptable — back it up like any other credential,
# don't regenerate it casually.
ENVELOPE_MASTER_KEY=

# FR-5.2 bootstrap admin credential — authorizes every vhost, used to mint
# vhost-scoped tokens (internal/apiauth) for day-to-day API traffic. If
# unset, one is generated and printed to the log on boot (dev-only
# convenience — it doesn't survive a restart, so anything other than
# throwaway local dev should set this explicitly).
# ENVELOPE_API_ADMIN_TOKEN=

# /metrics listener (NFR-OBS-1) — every process exposes this regardless of
# --roles, since a scrape target shouldn't need to know which role subset
# a given process happens to run.
# ENVELOPE_METRICS_ADDR=:9090

# Log verbosity (NFR-OBS-2) — debug, info, warn, or error. Every process
# logs structured JSON to stdout regardless of this setting; this only
# controls the minimum level emitted. Defaults to info.
# ENVELOPE_LOG_LEVEL=info

# NFR-SEC-4's dedicated per-client-IP API rate limit (distinct from FR-5.2
# token auth) — starting points, not tuned production values. Only takes
# effect when a reverse proxy in front of the api role sets
# X-Forwarded-For (see internal/api.RateLimitPolicy's doc for why: Goose
# has no way to read the raw connection's remote address).
# ENVELOPE_RATELIMIT_API_CAPACITY=60
# ENVELOPE_RATELIMIT_API_REFILL_PER_SECOND=1

# NFR-COMP-1's retention purge (runs bundled into --roles=api, see
# cmd/envelope/main.go). DEFAULT_DAYS applies to any vhost with no
# RetentionDays of its own set via PATCH /vhosts/:id/policy — not a
# legally reviewed number, just a starting point.
# ENVELOPE_RETENTION_DEFAULT_DAYS=90
# ENVELOPE_RETENTION_SWEEP_INTERVAL_HOURS=24

# Role listener addresses (internal/platform/smtp, internal/platform/imap).
# Defaults are the standard ports (25/587/993), which need root/
# CAP_NET_BIND_SERVICE to bind — override to unprivileged ports for local
# dev, e.g.:
# ENVELOPE_SMTP_INBOUND_ADDR=127.0.0.1:2525
# ENVELOPE_SMTP_SUBMISSION_ADDR=127.0.0.1:2587
# ENVELOPE_IMAP_ADDR=127.0.0.1:2993

# HELO/EHLO identity smtp-inbound and smtp-submission announce to peers,
# and the domain internal/deliverer (--roles=deliverer) both announces as
# and uses for its generated DSNs' postmaster address. "localhost" is a
# dev-only placeholder — a real deployment sending to the real internet
# needs a real domain here.
# ENVELOPE_DOMAIN=localhost

# FR-1.3's real ACME automation (internal/acme + caddyserver/certmagic) —
# issues real Let's Encrypt certificates on demand for every active vhost
# instead of the self-signed dev cert. Unset (the default) keeps the
# self-signed behavior unchanged. Setting ENVELOPE_ACME_EMAIL is your
# explicit agreement to the CA's subscriber agreement (there is no
# separate interactive prompt). Needs port 80 reachable from the public
# internet for whichever domain is being issued (HTTP-01 challenge) in
# addition to CAP_NET_BIND_SERVICE to bind it, the same requirement
# 25/587/993 already have.
# ENVELOPE_ACME_EMAIL=
# ENVELOPE_ACME_STAGING=1   # Let's Encrypt's staging CA — untrusted certs, but doesn't spend production rate limits; unset for real certs

# Outbound deliverer (internal/deliverer, FR-3.x) — --roles=deliverer.
# Port 25 is real remote-MTA SMTP; override only for local testing against
# something other than the real internet.
# ENVELOPE_DELIVERER_SMTP_PORT=25
# ENVELOPE_DELIVERER_PER_DOMAIN_CONCURRENCY=5

# rspamd sidecar (internal/filter, FR-2.4/2.5) — inbound's spam-score
# signal. Unreachable is a supported state, not just a dev convenience:
# FR-2.6 fails open (quarantines rather than blocking mail) when this
# can't be reached, incrementing envelope_spam_scorer_unavailable_total.
ENVELOPE_RSPAMD_URL=http://localhost:11333

# Inbound rate limiting (internal/ratelimit, FR-2.3) — token-bucket
# capacity and refill rate, shared across replicas via Postgres. These
# are starting points, not tuned production values.
# ENVELOPE_RATELIMIT_IP_CAPACITY=20
# ENVELOPE_RATELIMIT_IP_REFILL_PER_SECOND=1
# ENVELOPE_RATELIMIT_SENDER_CAPACITY=10
# ENVELOPE_RATELIMIT_SENDER_REFILL_PER_SECOND=0.5
